# ============================================================================
# AURA — Database Configuration Template (Supabase Cloud PostgreSQL)
# Copy this file to src/main/resources/db.properties and enter your credentials.
# Never commit real credentials to git!
# ============================================================================

# Supabase PostgreSQL JDBC Connection URL
# Replace [YOUR_PROJECT_REF] with your Supabase project reference ID
db.url=jdbc:postgresql://db.[YOUR_PROJECT_REF].supabase.co:5432/postgres?sslmode=require

# Database User (Default for Supabase is postgres)
db.user=postgres

# Database Password set during Supabase project creation
db.password=YOUR_SUPABASE_DATABASE_PASSWORD

# PostgreSQL JDBC Driver
db.driver=org.postgresql.Driver
