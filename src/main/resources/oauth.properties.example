# ============================================================================
# AURA Google OAuth 2.0 Configuration Template
# Copy this file to 'oauth.properties' in the same directory and fill in your values.
# NEVER commit real credentials to version control!
# ============================================================================

# Google Cloud Console OAuth 2.0 Credentials
# Obtain these from: https://console.cloud.google.com/apis/credentials
oauth.google.client.id=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
oauth.google.client.secret=YOUR_GOOGLE_CLIENT_SECRET

# Redirect URI configured in Google Cloud Console
# Must match Authorized redirect URIs in Google Cloud Console exactly
oauth.google.redirect.uri=http://localhost:8080/callback

# Loopback HTTP Server Port (must match port in redirect.uri)
oauth.server.port=8080

# Enforced Institutional Domain
oauth.enforced.domain=tkmce.ac.in

# Development / Offline Mock Mode (true = allows one-click mock login without Google credentials)
oauth.dev.mode=true
